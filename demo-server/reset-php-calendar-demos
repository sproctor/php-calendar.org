#!/bin/bash
# Nightly reset of the PHP-Calendar demos, then fresh sample events dated around today.
#   release: restored from its baseline (admin and demo accounts, calendar settings, categories)
#   dev:     built by the migrations, then seed.php adds the accounts, calendar and categories. A saved
#            database would miss whatever the baseline migration creates only for new databases.
# Runs before update-php-calendar-demos, which applies any newer dev migrations afterwards.
set -euo pipefail

as_web() { setpriv --reuid=www-data --regid=www-data --init-groups env HOME=/tmp "$@"; }
# The production logger writes deprecations to stderr, which would bury real errors in the journal
no_deprecations() { grep -v '"channel":"deprecation"' || true; }

for which in release dev; do
    db=phpc_$which
    mariadb -e "DROP DATABASE IF EXISTS $db; CREATE DATABASE $db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
    if [ "$which" = dev ]; then
        (cd /srv/phpc/dev && as_web php bin/console doctrine:migrations:migrate -q --no-interaction 2>&1 | no_deprecations)
    else
        mariadb "$db" < "/var/lib/php-calendar-demo/$db.sql"
    fi
    php /usr/local/lib/php-calendar-demo/seed.php "$which"
done
# Logins and cached pages from before the reset are no longer valid
rm -rf /srv/phpc/dev/var/sessions/* 2>/dev/null || true
(cd /srv/phpc/dev && as_web php bin/console cache:pool:clear --all -q 2>&1 | no_deprecations) || true
echo "reset done"
